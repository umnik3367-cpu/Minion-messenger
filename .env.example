# ============================================================
# Minion Messenger — environment configuration
# Copy this file to `.env` and fill in your secrets.
# ============================================================

# ---------- Core ----------
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---------- Database (PostgreSQL) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minion_messenger?schema=public

# ---------- Auth / Security ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ---------- Storage ----------
# local | s3
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50
# S3 (optional cloud storage)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- Minion AI (paste your keys — the AI works as soon as one is set) ----------
# Any OpenAI-compatible gateway works (LiteLLM, OpenRouter, Groq, vLLM…).
# Priority: MINION_API_KEYS/MINION_API_KEY > OPENAI_API_KEY > ANTHROPIC_API_KEY > GOOGLE_AI_KEY
MINION_API_URL=https://api.kosareva.cloud/v1
# Several keys? Separate them with commas — the API fails over automatically.
MINION_API_KEYS=
# MINION_API_KEY=                 # single-key alternative (used when KEYS is empty)
MINION_MODEL=gpt-4-1
# Curated models for the switcher. With MINION_DISCOVER_MODELS=true the real list
# is fetched from the gateway's /models endpoint (LiteLLM often serves 100+).
MINION_MODELS=gpt-4-1,gpt-4-1-mini,alice-ai,gigachat-3-pro,qwen3-8-27b
MINION_DISCOVER_MODELS=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_AI_KEY=
GOOGLE_MODEL=gemini-1.5-pro-latest
# Image generation model (OpenAI images)
AI_IMAGE_MODEL=dall-e-3

# ---------- E-mail (SMTP) — real verification & password-reset letters ----------
# Any SMTP provider works: Gmail, Mailgun, SendGrid, Resend, your own Postfix…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Minion Messenger <no-reply@minion.me>
MAIL_FROM_NAME=Minion Messenger

# ---------- SMS (real delivery to a phone number) — pick ONE provider ----------
# Twilio: https://console.twilio.com  (TWILIO_FROM = your Twilio phone number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Vonage (Nexmo): https://dashboard.nexmo.com  (VONAGE_FROM = a sender id or number)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# ---------- WebRTC TURN relay (for real cross-network calls) ----------
# STUN alone fails behind strict NATs / corporate firewalls. Add a TURN server so
# calls connect everywhere. Free relay: https://www.metered.ca/tools/openrelay/
# (or self-host coturn). Comma-separate multiple URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---------- Language / localisation ----------
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ru

# ---------- Realtime ----------
SOCKET_CORS_ORIGIN=http://localhost:5173

# ---------- Frontend (Vite — client/.env) ----------
# VITE_API_URL=http://localhost:4000/api
# VITE_SOCKET_URL=http://localhost:4000

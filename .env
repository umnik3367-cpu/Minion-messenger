# Minion Messenger — local environment (see .env.example for documentation)
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/minion_messenger?schema=public
JWT_ACCESS_SECRET=b5f3a1c9d7e24f68a0b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3
JWT_REFRESH_SECRET=f6e5d4c3b2a190887766554433221100ffeeddccbbaa99887766554433221100
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=12
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=50

# ---- Neural models (AI) ----
# MINION gateway (OpenAI-compatible /v1), tried in order with automatic failover.
AI_ENABLED=true
# Active gateway: StepFun (阶跃星辰) — OpenAI-compatible. Keys confirmed HTTP 200.
# NOTE: base URL is api.stepfun.ai/v1 — NOT platform.stepfun.ai/interface-key (that's the web console page).
MINION_API_URL=https://api.stepfun.ai/v1
MINION_API_KEYS=1VgWEdHEuz7MCoxJ8UVcAE308Jd6VfKsnTmWyTLFjTZQLEQTFxVnfDvoSJvyTnDUH,seEJwtdt13ITsbGTizQAQ4Y26a7rjLBMSiLBKNdeknn8F28JaiTRK7sO9RsA8EVp
# MINION_API_KEY=                 # single-key alternative (used when KEYS is empty)
#
# Previous local gateway (localhost:20128) — never reachable; kept for reference/rollback:
#    MINION_API_URL=http://localhost:20128/v1
#    MINION_API_KEYS=sk-cf11728713a0b5f2-b04ef3-87f75f10,sk-6fad00ca6a534d42a8b5096d9ae8ab5d
#
# Previous kosareva.cloud keys — all rejected/depleted (402/401), kept for reference:
#    • sk-dde8…  → "Ключ не найден… перевыпустите ключ в кабинете" (401)
#    • sk-1gO0… → "На балансе недостаточно средств" (402)
#    • sk-43N_X…→ restricted to 14 models, also out of balance (402)
# MINION_API_KEYS=sk-dde8ac8192c24f2d90979ea41d98df10,sk-1gO0IBIjLBoaDF8HQmuZCA,sk-43N_XDgE9Ew4XJCDAY0EuA
# StepFun models: step-* are reasoning models (they spend tokens on reasoning first,
# so keep max_tokens high — the app's chat default of 2048 is safely above that).
MINION_MODEL=step-3.5-flash
MINION_MODELS=step-3.5-flash,step-3.5-flash-2603,step-3.7-flash
MINION_DISCOVER_MODELS=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-2025-04-14
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GOOGLE_AI_KEY=
GOOGLE_MODEL=gemini-1.5-pro-latest
AI_IMAGE_MODEL=dall-e-3

# ---- Unidentified credentials (rejected by /v1 — LiteLLM requires an 'sk-' prefix) ----
# rk_live_kAMb7Oq1fsnVwHhWwB8WqpMRv4zbTlD3
# mg_live_4d7b78c810_nCMIdgrotVn8ciWf2r0CRyET423D42Sg

# ---- Real e-mail (SMTP): verification & password-reset letters actually arrive ----
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=<your@gmail.com>,
#        SMTP_PASS=<16-char App Password>  (https://myaccount.google.com/apppasswords)
# Mailgun: SMTP_HOST=smtp.mailgun.org, SMTP_USER=postmaster@<domain>, SMTP_PASS=<key>
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_USER=apikey, SMTP_PASS=<key>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Minion Messenger <no-reply@minion.me>
MAIL_FROM_NAME=Minion Messenger

# ---- Language / localisation ----
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,ru

SOCKET_CORS_ORIGIN=http://localhost:5173
